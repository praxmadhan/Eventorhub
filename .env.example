# ─── Copy this file to ".env" and fill in your real values ───
# Local-la DATABASE_URL kudukkalaina SQLite (database.db) use aagum.
# Deploy panrappa idha set pannina, Postgres-la data permanent-a save aagum.

# Postgres connection string (Supabase Connect button -> Connection string)
# Vercel-ku Supabase-oda "Transaction pooler" URL (port 6543) use pannunga.
# Password-la special char (@ # : /) irundha URL-encode pannanum (@ -> %40).
# Example: postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ─── Supabase Storage (Vercel-la image upload-ku KANDIPPA thevai) ───
# Vercel filesystem read-only, so poster/QR images Supabase Storage-la save aagum.
# Supabase-la "uploads" peru-la oru PUBLIC bucket create pannunga.
SUPABASE_URL=https://lxqehjrqsfpdfxxzfymd.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uploads

# Flask session secret (production-la kandippa maathunga)
SECRET_KEY=change-this-to-a-long-random-string

# Email (Gmail App Password use pannunga, normal password illa)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Razorpay (paid events-ku mattum thevai)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
